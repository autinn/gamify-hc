# ==============================================================================
# GAMIFY-HC BACKEND CONFIGURATION
# ==============================================================================
# Copy this file to .env and update values for your environment
# This follows 12-Factor App methodology - all config in environment variables
#
# ADMIN CLI COMMANDS (12-Factor: Admin Processes):
#   python -m backend.cli seed           # Seed database with course data
#   python -m backend.cli create-user    # Create a new user account
#   python -m backend.cli reset-db       # Reset database (danger!)
#   python -m backend.cli db-info        # Display database statistics

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Required: Yes
DATABASE_URL=postgresql://gamify:gamify_secret@localhost:5432/gamify_hc

# Show SQL queries in logs (useful for debugging)
# Values: true, false, 1, 0, yes, no
# Default: false
SQLALCHEMY_ECHO=false

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# Flask environment mode
# Values: development, production, testing
# Default: production
FLASK_ENV=development

# Host to bind to (0.0.0.0 allows external connections)
# Default: 0.0.0.0
HOST=0.0.0.0

# Port to run the server on
# Default: 5001
PORT=5001

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
# Secret key for JWT token signing
# IMPORTANT: Change this in production! Use a strong random string
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required: Yes
JWT_SECRET_KEY=dev-secret-key-change-in-production

# JWT token expiration time in hours
# Default: 24
JWT_EXPIRATION_HOURS=24

# ==============================================================================
# CORS (Cross-Origin Resource Sharing)
# ==============================================================================
# Allowed origins for CORS (comma-separated)
# Use * for development, specific domains for production
# Examples: http://localhost:3000,https://myapp.com
# Default: *
CORS_ORIGINS=*

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
# Logging level
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Log format
# Values: json (for production), text (for development)
# Default: text
LOG_FORMAT=text

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
# Application version (for health checks and monitoring)
# Default: 1.0.0
APP_VERSION=1.0.0

# Application name
# Default: gamify-hc
APP_NAME=gamify-hc

# ==============================================================================
# GUNICORN CONFIGURATION (Production)
# ==============================================================================
# Number of worker processes
# Recommended: (2 x CPU cores) + 1
# Default: Auto-calculated based on CPU count
GUNICORN_WORKERS=4

# Worker class (sync, gevent, eventlet, tornado)
# sync: for CPU-bound work, gevent/eventlet: for I/O-bound work
# Default: sync
GUNICORN_WORKER_CLASS=sync

# Number of threads per worker (for sync workers only)
# Default: 2
GUNICORN_THREADS=2

# Worker timeout in seconds
# Default: 30
GUNICORN_TIMEOUT=30

# Graceful timeout for workers in seconds
# Default: 30
GUNICORN_GRACEFUL_TIMEOUT=30

# Max requests a worker will process before restarting
# Helps prevent memory leaks
# Default: 1000
GUNICORN_MAX_REQUESTS=1000

# Randomness to add to max_requests (prevents all workers restarting at once)
# Default: 50
GUNICORN_MAX_REQUESTS_JITTER=50

# Keep-alive timeout in seconds
# Default: 5
GUNICORN_KEEPALIVE=5

# ==============================================================================
# DEVELOPMENT CONFIGURATION
# ==============================================================================
# Enable debug mode (DO NOT USE IN PRODUCTION)
# Values: true, false, 1, 0
# Default: false
DEBUG=false

# Enable auto-reload on code changes (development only)
# Values: true, false, 1, 0
# Default: false
AUTO_RELOAD=false
