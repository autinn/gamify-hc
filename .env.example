# ========================================
# FRONTEND CONFIGURATION
# ========================================

# API Configuration
# Set the base URL for the backend API
# For local development: http://localhost:5001/api
# For production: https://api.gamify-hc.example.com/api
REACT_APP_API_BASE_URL=http://localhost:5001/api

# ========================================
# BACKEND CONFIGURATION
# ========================================

# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://gamify:gamify_secret@localhost:5432/gamify_hc

# Database password for docker-compose
POSTGRES_PASSWORD=gamify_secret

# PostgreSQL port (exposed to host)
POSTGRES_PORT=5432

# Flask Application Configuration
# Enable debug mode (True for development, False for production)
FLASK_DEBUG=True

# Server host (0.0.0.0 to accept connections from any IP)
FLASK_HOST=0.0.0.0

# Server port
FLASK_PORT=5001

# Flask environment (development, production, testing)
FLASK_ENV=development

# JWT Configuration
# Secret key for JWT token generation (MUST be changed in production!)
JWT_SECRET_KEY=dev-secret-key-change-in-production

# JWT algorithm for token encoding/decoding
JWT_ALGORITHM=HS256

# JWT token expiration time in hours
JWT_EXPIRATION_HOURS=24

# SQLAlchemy Configuration
# Enable SQL query logging (useful for debugging)
SQLALCHEMY_ECHO=False

# Database connection pool configuration
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20
SQLALCHEMY_POOL_PRE_PING=True
SQLALCHEMY_POOL_RECYCLE=300

# Auto-seed database with initial data if empty
AUTO_SEED_DATABASE=True