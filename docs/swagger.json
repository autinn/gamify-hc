              }
            }
          }
        }
      }
    },
    "/api/units/{unit_id}/concepts": {
      "get": {
        "tags": [
          "Units"
        ],
        "summary": "List concepts for a unit",
        "parameters": [
          {
            "name": "unit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Concepts",
