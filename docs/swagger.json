              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quiz card",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizCard"
                }
              }
            }
          },
          "404": {
            "description": "Quiz card not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/courses/{course_id}/quiz-cards": {
      "get": {
        "tags": [
          "Quiz"
        ],
        "summary": "List quiz cards for a course",
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quiz cards",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QuizCard"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/units/{unit_id}/quiz-cards": {
      "get": {
        "tags": [
