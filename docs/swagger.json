                }
              }
            }
          }
        }
      }
    },
    "/api/concepts/{concept_id}/quiz-cards": {
      "get": {
        "tags": [
          "Concepts"
        ],
        "summary": "List quiz cards for a concept",
        "parameters": [
          {
            "name": "concept_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quiz cards",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QuizCard"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/quiz-cards/{quiz_card_id}": {
      "get": {
