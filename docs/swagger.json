          }
        ],
        "responses": {
          "200": {
            "description": "Concept",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Concept"
                }
              }
            }
          },
          "404": {
            "description": "Concept not found",
            "content": {
              "application/json": {
