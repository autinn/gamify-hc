            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quiz cards",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QuizCard"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/quiz-cards/random": {
      "get": {
        "tags": [
          "Quiz"
        ],
        "summary": "List all quiz cards (random selection handled by client)",
        "responses": {
          "200": {
            "description": "Quiz cards",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QuizCard"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/quiz-submit": {
      "post": {
        "tags": [
          "Quiz"
        ],
        "summary": "Submit quiz answer",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuizSubmissionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Submission result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizSubmissionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid submission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/{user_id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get user profile",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/{user_id}/progress": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get quiz progress for a user",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Progress entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserProgress"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/progress/courses": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get progress aggregated by courses",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Course progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressChart"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/progress/courses/{course_id}/units": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get progress aggregated by units",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unit progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressChart"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/progress/courses/{course_id}/units/{unit_id}/concepts": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get progress aggregated by concepts",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "unit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Concept progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressChart"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "example": "jdoe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@minerva.edu"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "strongpassword"
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Username or email",
            "example": "user@minerva.edu"
          },
          "password": {
            "type": "string",
            "example": "strongpassword"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT access token"
          },
          "user_id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "user_id",
          "username",
          "email"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "integer",
            "example": 1
          },
          "username": {
            "type": "string",
            "example": "jdoe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@minerva.edu"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "user_id",
          "username",
          "email"
        ]
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "code": {
            "type": "string",
            "example": "EA50"
          },
          "name": {
            "type": "string",
            "example": "Essential Algebra"
          },
          "description": {
            "type": "string",
            "example": "Core algebra concepts"
          }
        },
        "required": [
          "id",
          "code",
          "name"
        ]
      },
      "Unit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 10
          },
          "course_id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Introduction"
          },
          "description": {
            "type": "string",
            "example": "Foundational material"
          },
          "order_index": {
            "type": "integer",
            "example": 0
          }
        },
        "required": [
          "id",
          "course_id",
          "name"
        ]
      },
      "Concept": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 100
          },
          "unit_id": {
            "type": "integer",
            "example": 10
          },
          "name": {
            "type": "string",
            "example": "Variables"
          },
          "tag": {
            "type": "string",
            "example": "Variables"
          },
          "definition": {
            "type": "string",
            "example": "A variable stores a value that can change."
          }
        },
        "required": [
          "id",
          "unit_id",
          "name",
          "tag",
          "definition"
        ]
      },
      "QuizAnswer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1000
          },
          "answer_text": {
            "type": "string",
            "example": 42
          },
          "is_correct": {
            "type": "boolean",
            "example": true
          },
          "explanation": {
            "type": "string",
            "nullable": true,
            "example": "The calculation results in 42."
          }
        },
        "required": [
          "id",
          "answer_text",
          "is_correct"
        ]
      },
      "QuizCard": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 200
          },
          "concept_id": {
            "type": "integer",
            "example": 100
          },
          "question": {
            "type": "string",
            "example": "What is 6 x 7?"
          },
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuizAnswer"
            }
          }
        },
        "required": [
